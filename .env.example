# ==============================================================================
# RASOIAI - ENVIRONMENT TEMPLATE
# Copy this file to .env or .env.local and fill in your real credentials.
# NOTE: Never commit your real API keys to git.
# ==============================================================================

PORT=3000
NODE_ENV=production
APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# RasoiAI Vision & LLM Key
# (On Vercel: Add GEMINI_API_KEY to your Vercel Project > Settings > Environment Variables)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# Supabase PostgreSQL Configuration (Optional Cloud Sync)
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key-here
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-publishable-key-here